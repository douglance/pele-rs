+// Public graph consumer workloads: keys allocated before timed/counted region.
+fn property_keys(count: usize, unique: bool) -> Vec<Vec<String>> {
+    (0..count)
+        .map(|row| {
+            (0..16)
+                .map(|field| {
+                    if unique {
+                        format!("key_{row}_{field}")
+                    } else {
+                        format!("field_{field}")
+                    }
+                })
+                .collect()
+        })
+        .collect()
+}
+fn property_graph(keys: &[Vec<String>]) -> Result<ModelGraph, String> {
+    let mut w = GraphWriter::default();
+    // Existing raw UTF16 intern IDs interleave with property-key lookups.
+    let seed = w.string(JsString(vec![0xd800]));
+    let shared = w.string("field_0");
+    let mut records = vec![];
+    for row in keys {
+        let properties = row
+            .iter()
+            .map(|key| w.property(key, Atom::String(shared)))
+            .collect();
+        records.push(Atom::Ref(w.node(Node::Object { properties })));
+    }
+    // Raw string insertion after cached property lookup must reuse exact ID.
+    assert_eq!(
+        w.string(JsString("field_0".encode_utf16().collect())),
+        shared
+    );
+    let late = w.string("\u{fffd}");
+    assert_ne!(late, seed);
+    let mut properties = vec![
+        w.property("", Atom::String(seed)),
+        w.property("\u{fffd}", Atom::String(late)),
+    ];
+    // Exercise keys exceeding cache byte/entry bounds, with no scalar coercion.
+    properties.push(w.property(&"é".repeat(40), Atom::String(shared)));
+    properties.push(w.property("field_0", Atom::String(shared)));
+    let values = records;
+    for (index, value) in values.iter().enumerate() {
+        properties.push(w.property(&index.to_string(), value.clone()));
+    }
+    let root = w.node(Node::Array {
+        length: values.len() as u32,
+        properties,
+    });
+    w.finish(Atom::Ref(root)).map_err(error)
 }
+fn property_summaries(repeated: &[Vec<String>], unique: &[Vec<String>]) -> Result<J, String> {
+    let mut result = serde_json::Map::new();
+    for (name, keys) in [("repeated", repeated), ("unique", unique)] {
+        let g = property_graph(keys)?;
+        let bytes = serde_json::to_vec(&g).map_err(error)?;
+        result.insert(name.into(),json!({"sha256":format!("{:x}",Sha256::digest(bytes)),"nodes":g.nodes.len(),"strings":g.strings.len(),"properties":g.nodes.iter().map(|n|n.properties().len()).sum::<usize>()}));
+    }
+    Ok(J::Object(result))
+}
